{
  "name": "zero-cycle-trainer",
  "version": "1.2.0",
  "description": "Zero Cycle Trainer for Minecraft speedrunning",
  "main": "main.js",
  "author": "Zero Cycle Trainer",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {"electron-updater": "^6.6.2"},
  "devDependencies": {"electron": "^35.7.5", "electron-builder": "^26.0.12"},
  "build": {
    "appId": "com.zerocycletrainer.app",
    "productName": "Zero Cycle Trainer",
    "asar": true,
    "files": ["index.html", "main.js", "preload.js", "package.json"],
    "directories": {"output": "dist"},
    "win": {"target": [{"target":"nsis", "arch":["x64"]}], "icon":"assets/icon.ico"},
    "nsis": {"oneClick": true, "perMachine": false, "allowToChangeInstallationDirectory": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName":"Zero Cycle Trainer"},
    "publish": [{"provider":"github", "owner":"felixlycklig308-art", "repo":"Zero-Cycle-Trainer"}]
  }
}
